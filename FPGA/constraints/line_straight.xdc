# Stage2 car top only. Final wiring: four motor channels, new line/US/ESP pins.
set_property PACKAGE_PIN D19 [get_ports {reset_button}]
set_property PACKAGE_PIN D20 [get_ports {start_button}]
set_property PACKAGE_PIN R14 [get_ports {status_led}]
set_property PACKAGE_PIN P14 [get_ports {line_led[0]}]
set_property PACKAGE_PIN N16 [get_ports {line_led[1]}]
set_property PACKAGE_PIN M14 [get_ports {line_led[2]}]
set_property PACKAGE_PIN Y18 [get_ports {motor_left_pwm}]
set_property PACKAGE_PIN Y19 [get_ports {motor_left_in1}]
set_property PACKAGE_PIN Y16 [get_ports {motor_left_in2}]
set_property PACKAGE_PIN Y17 [get_ports {motor_left_rear_pwm}]
set_property PACKAGE_PIN U18 [get_ports {motor_left_rear_in1}]
set_property PACKAGE_PIN U19 [get_ports {motor_left_rear_in2}]
set_property PACKAGE_PIN W14 [get_ports {motor_right_pwm}]
set_property PACKAGE_PIN Y14 [get_ports {motor_right_in1}]
set_property PACKAGE_PIN T11 [get_ports {motor_right_in2}]
set_property PACKAGE_PIN T10 [get_ports {motor_right_rear_pwm}]
set_property PACKAGE_PIN V16 [get_ports {motor_right_rear_in1}]
set_property PACKAGE_PIN W16 [get_ports {motor_right_rear_in2}]
set_property PACKAGE_PIN W13 [get_ports {motor_stby}]
set_property PACKAGE_PIN V12 [get_ports {us_trig}]
set_property PACKAGE_PIN B19 [get_ports {us_echo}]
set_property PACKAGE_PIN U7 [get_ports {gray[4]}]
set_property PACKAGE_PIN C20 [get_ports {gray[3]}]
set_property PACKAGE_PIN Y8 [get_ports {gray[2]}]
set_property PACKAGE_PIN A20 [get_ports {gray[1]}]
set_property PACKAGE_PIN Y9 [get_ports {gray[0]}]
set_property PACKAGE_PIN W18 [get_ports {esp_rx}]
set_property PACKAGE_PIN W19 [get_ports {esp_tx}]
set_property PACKAGE_PIN Y12 [get_ports {estop_n}]
set_property PACKAGE_PIN W11 [get_ports {help_btn_n}]
set_property PACKAGE_PIN V11 [get_ports {buzzer_drv}]
set_property PACKAGE_PIN F19 [get_ports {enc_lf_a}]
set_property PACKAGE_PIN V10 [get_ports {enc_lf_b}]
set_property PACKAGE_PIN V8 [get_ports {enc_lr_a}]
set_property PACKAGE_PIN W10 [get_ports {enc_lr_b}]
set_property PACKAGE_PIN B20 [get_ports {enc_rf_a}]
set_property PACKAGE_PIN W8 [get_ports {enc_rf_b}]
set_property PACKAGE_PIN V6 [get_ports {enc_rr_a}]
set_property PACKAGE_PIN Y6 [get_ports {enc_rr_b}]
# PCLK: RPi physical pin 18 / Y7 (P-side MRCC). Voice BUSY reserved on pin 22 / F20.
set_property IOSTANDARD LVCMOS33 [get_ports -filter {NAME !~ DDR* && NAME !~ FIXED_IO*}]
# External 3.3k divider provides the Echo pull-down; match standalone I/O.
set_false_path -from [get_ports reset_button]
set_property PULLUP TRUE [get_ports {estop_n help_btn_n esp_rx gray[*]}]
set_property PULLDOWN TRUE [get_ports {enc_lf_a enc_lf_b enc_lr_a enc_lr_b enc_rf_a enc_rf_b enc_rr_a enc_rr_b}]

# BTN2 (L20), confirmed against AMD PYNQ-Z2 base.xdc v3.0.1.
set_property PACKAGE_PIN L20 [get_ports stop_button]
set_property PULLDOWN TRUE [get_ports stop_button]

set_false_path -from [get_ports us_echo] -to [get_cells -hier -filter {NAME =~ *echo_meta_dbg_reg}]


# Added camera ports; existing car pins above are unchanged.
set_property PACKAGE_PIN T14 [get_ports {cam_data[0]}]
set_property PACKAGE_PIN U12 [get_ports {cam_data[1]}]
set_property PACKAGE_PIN U13 [get_ports {cam_data[2]}]
set_property PACKAGE_PIN V13 [get_ports {cam_data[3]}]
set_property PACKAGE_PIN V15 [get_ports {cam_data[4]}]
set_property PACKAGE_PIN T15 [get_ports {cam_data[5]}]
set_property PACKAGE_PIN R16 [get_ports {cam_data[6]}]
set_property PACKAGE_PIN U17 [get_ports {cam_data[7]}]
set_property PACKAGE_PIN V17 [get_ports cam_href]
set_property PACKAGE_PIN V18 [get_ports cam_vsync]
set_property PACKAGE_PIN T16 [get_ports cam_sda]
set_property PACKAGE_PIN R17 [get_ports cam_scl]
set_property PACKAGE_PIN P18 [get_ports cam_reset_n]
# PCLK: RPi physical pin 18 / Y7 = IO_L13P_T2_MRCC_13.
# Reserve voice BUSY on RPi physical pin 22 / F20; never share pin 18.
set_property PACKAGE_PIN Y7 [get_ports cam_pclk]
set_property SLEW SLOW [get_ports {cam_scl cam_sda cam_reset_n}]
set_property DRIVE 4 [get_ports {cam_scl cam_sda cam_reset_n}]
set_property PULLUP false [get_ports {cam_scl cam_sda cam_reset_n}]
set_property PULLDOWN false [get_ports {cam_scl cam_sda cam_reset_n}]
# Retain the original provisional PCLK/input timing budget.
create_clock -name camera_pclk -period 23.809 [get_ports cam_pclk]
set_input_delay -clock camera_pclk -clock_fall -min 0.000 [get_ports {cam_data[*] cam_href cam_vsync}]
set_input_delay -clock camera_pclk -clock_fall -max 8.000 [get_ports {cam_data[*] cam_href cam_vsync}]
# Only synchronized single-bit configuration, permission and heartbeat cross.

# HDMI OUT pins from the board-confirmed color fix.
set_property -dict {PACKAGE_PIN L16 IOSTANDARD TMDS_33} [get_ports {hdmi_out_clk_p}]
set_property -dict {PACKAGE_PIN L17 IOSTANDARD TMDS_33} [get_ports {hdmi_out_clk_n}]
set_property -dict {PACKAGE_PIN K17 IOSTANDARD TMDS_33} [get_ports {hdmi_out_data_p[0]}]
set_property -dict {PACKAGE_PIN K18 IOSTANDARD TMDS_33} [get_ports {hdmi_out_data_n[0]}]
set_property -dict {PACKAGE_PIN K19 IOSTANDARD TMDS_33} [get_ports {hdmi_out_data_p[1]}]
set_property -dict {PACKAGE_PIN J19 IOSTANDARD TMDS_33} [get_ports {hdmi_out_data_n[1]}]
set_property -dict {PACKAGE_PIN J18 IOSTANDARD TMDS_33} [get_ports {hdmi_out_data_p[2]}]
set_property -dict {PACKAGE_PIN H18 IOSTANDARD TMDS_33} [get_ports {hdmi_out_data_n[2]}]
set_false_path -to [get_pins -hier -filter {NAME =~ */display/heartbeat_sync_reg[0]/D}]
set_false_path -to [get_pins -hier -filter {REF_PIN_NAME == CLR && NAME =~ */display/*/sync_reg*/CLR}]

# Existing ASRPRO six GPIO connections: PA0 PA1 PA2 PA3 PA5 PA6
set_property PACKAGE_PIN U8 [get_ports {voice_gpio[0]}]
set_property PACKAGE_PIN W6 [get_ports {voice_gpio[1]}]
set_property PACKAGE_PIN F20 [get_ports {voice_gpio[2]}]
set_property PACKAGE_PIN W9 [get_ports {voice_gpio[3]}]
set_property PACKAGE_PIN V7 [get_ports {voice_gpio[4]}]
set_property PACKAGE_PIN W15 [get_ports {voice_gpio[5]}]
set_property DRIVE 4 [get_ports {voice_gpio[*]}]
set_property SLEW SLOW [get_ports {voice_gpio[*]}]
